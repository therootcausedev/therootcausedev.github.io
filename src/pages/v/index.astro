---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalFrame from '../../components/TerminalFrame.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { slugify } from '../../lib/slug';

const videos = (await getCollection('videos')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Videos | The Root Cause"
  description="Short videos about how software systems really work and break: latency, incidents, root causes."
>
  <main class="wide">
    <TerminalFrame path="the-root-cause | videos" wide>
      <p class="line">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span>
        <span class="cmd">ls -la videos/</span>
      </p>
      <table>
        <caption>total {videos.length}</caption>
        <thead>
          <tr>
            <th>perm</th>
            <th>date</th>
            <th>name</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            videos.map((video) => (
              <tr>
                <td class="perm">-rw-r--r--</td>
                <td class="date">{dateFormatter.format(video.data.publishedAt)}</td>
                <td class="name">
                  <a href={`/v/${video.id}/`}>
                    {slugify(video.data.title)}<span class="ext">.mp4</span>
                  </a>
                </td>
                <td>
                  <div class="swatch">▶</div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="line last">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span> <span class="cursor">▌</span>
      </p>
    </TerminalFrame>
  </main>
  <SiteFooter wide />
</BaseLayout>
