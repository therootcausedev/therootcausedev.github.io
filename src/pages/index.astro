---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="The Root Cause"
  description="Short videos about how software systems really work and break: latency, incidents, root causes."
>
  <main>
    <TerminalFrame path="the-root-cause">
      <p class="line">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span>
        <span class="cmd">cat about.md</span>
      </p>
      <h1>The Root Cause</h1>
      <p>Short videos about how software systems really work and break: latency, incidents, root causes.</p>
      <p class="line">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span>
        <a class="cmd-link" href="https://www.youtube.com/@therootcausedev">open https://www.youtube.com/@therootcausedev</a>
      </p>
      <p class="line last">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span> <span class="cursor">▌</span>
      </p>
    </TerminalFrame>
  </main>
  <SiteFooter />
</BaseLayout>
