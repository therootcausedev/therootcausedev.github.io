---
import BaseLayout from './BaseLayout.astro';
import TerminalFrame from '../components/TerminalFrame.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { slugify } from '../lib/slug';
import type { CollectionEntry } from 'astro:content';

interface Props {
  video: CollectionEntry<'videos'>;
}

const { video } = Astro.props;
const { title, videoId, officialLinks } = video.data;
const fileSlug = slugify(title);
---

<BaseLayout title={`${title} | The Root Cause`} description={title}>
  <main class="wide">
    <TerminalFrame path={`the-root-cause | videos/${fileSlug}`}>
      <p class="line">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span>
        <span class="cmd">cat videos/{fileSlug}.md</span>
      </p>
      <h1>{title}</h1>
      <div class="video-embed">
        <iframe
          src={`https://www.youtube.com/embed/${videoId}`}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
      <slot />
      {
        officialLinks.length > 0 && (
          <div class="official-links">
            <h2>Official links</h2>
            <ul>
              {officialLinks.map((link) => (
                <li>
                  <a href={link.url} data-goatcounter-click={slugify(link.label)} rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <p class="line back">
        <span class="prompt-user">the-root-cause</span><span class="prompt-sep">:~$ </span>
        <a class="cmd-link" href="/v/">cd ..</a>
      </p>
    </TerminalFrame>
  </main>
  <SiteFooter />
</BaseLayout>
